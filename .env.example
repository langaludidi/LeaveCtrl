NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
LEAVECTRL_APP_URL=https://app.leavectrl.co.za
# Keep false in normal preview deployments. Enable only for a deliberate,
# isolated preview authentication-email test with its callback authorised.
LEAVECTRL_ENABLE_PREVIEW_AUTH_EMAIL=false
# Server-only production billing. Never prefix these with NEXT_PUBLIC_.
# The existing Vercel name Live_secret_key is also supported.
PAYSTACK_SECRET_KEY=
SUPABASE_SECRET_KEY=
# Enable in Production after the live webhook is configured and rollout reviewed.
LEAVECTRL_BILLING_ENABLED=false
